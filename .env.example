# Everything here is optional — each value defaults to production.

# WalletConnect project id (cloud.reown.com). Without it the app ships
# injected-only and nobody on a phone browser can connect a wallet (the build
# warns). Register the site's origin on the project, or wallets show "cannot
# verify domain" over every signature request.
VITE_WC_PROJECT_ID=

# Overrides, for a proxy or a local stack only:
# VITE_BACKEND_BASE_URL=https://allocator.api.1delta.io
# VITE_SITE_URL=https://app.yieldcircle.io   (the landing's build defaults to https://yieldcircle.io)
# VITE_APP_URL=https://app.yieldcircle.io    (the landing only: where it links into the app)
# VITE_INDEX_BASE_URL=https://positions.1delta.io
# VITE_SOL_INDEX_BASE_URL=https://sol-positions.1delta.io
# VITE_SOCIAL_BASE_URL=https://social.1delta.io
# VITE_XLINK_URL=

# Per-chain RPC, optional: the transaction-receipt watcher (`sdk/txTrace.ts`).
# Asked first while it answers; without it (and behind it) reads rotate over
# public browser-friendly endpoints (`wallet/evmRpc.ts`).
VITE_RPC_1=
VITE_RPC_8453=
VITE_RPC_42161=
VITE_RPC_56=
VITE_RPC_43114=

# Solana RPC, optional: the signature-status watcher after a Solana
# transaction. Asked first when set; without it (and behind it) reads rotate
# over public browser-friendly endpoints (`wallet/solRpc.ts`). Never
# api.mainnet-beta, which refuses browser requests (403 on any Origin).
# VITE_RPC_SOLANA=https://mainnet.helius-rpc.com/?api-key=…

# ── Server side: never in a bundle ────────────────────────────────────────
# Only VITE_* reaches the app (and, as EXPO_PUBLIC_*, the phone). These are the
# Pages secrets and variables (docs/deploy.md), kept here for the local scripts;
# in production they live in Cloudflare, not in this file.

# The waitlist's Telegram bot (packages/web/gate/bot.ts). Token from @BotFather;
# the webhook secret from `openssl rand -hex 32`. Both also as Secrets on the
# app project, the token on the landing too.
#   node --env-file=.env scripts/telegram.mjs webhook   (register the webhook)
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
# Telegram user ids allowed to use the bot, comma-separated (the bot tells you yours)
# TELEGRAM_ADMIN=

# App Store Connect API, for the bot's TestFlight invites (gate/testflight.ts).
# A Team Key with the App Manager role (Users and Access → Integrations → Team
# Keys) — not the key EAS made for uploading builds. Its .p8 downloads once:
# keep it outside the repo. On the app project, ASC_PRIVATE_KEY is set from the
# file (`npx wrangler pages secret put ASC_PRIVATE_KEY --project-name yieldcircle < ~/keys/AuthKey_….p8`).
ASC_KEY_ID=
ASC_ISSUER_ID=
# the Alpha group's id: the last part of its URL in App Store Connect → TestFlight
ASC_GROUP_ID=
# where the .p8 lives on this machine (for local checks; never its contents here)
# ASC_KEY_PATH=~/keys/AuthKey_XXXXXXXXXX.p8
