# Backend base URL. The public endpoint (https://portal.1delta.io) is rate-limited per IP;
# https://allocator.api.1delta.io carries credits and is not. Point production at a proxy that attaches your key.
VITE_BACKEND_BASE_URL=https://allocator.api.1delta.io
# WalletConnect project id (cloud.reown.com). REQUIRED for a deployed build:
# without it the app ships injected-only and NOBODY on a phone browser can
# connect a wallet at all. `pnpm deploy` and a production `vite build` both
# refuse without it (VITE_ALLOW_NO_WC=1 overrides, for a read-only build).
# Register VITE_SITE_URL and any *.pages.dev preview origin on the same project,
# or wallets show "cannot verify domain" over every signature request.
VITE_WC_PROJECT_ID=
# Public origin, no trailing slash (canonical / og tags).
VITE_SITE_URL=https://yieldcircle.pages.dev
# The position index and the social service (pos-indexer). Both are public and
# unauthenticated; override only to point at a local stack (:8090 / :8091).
VITE_INDEX_BASE_URL=https://positions.1delta.io
VITE_SOCIAL_BASE_URL=https://social.1delta.io

# Per-chain RPC, optional. The app reads almost everything from the allocator
# API; these are used by the transaction-receipt watchers, which is the one
# place a rate-limited public endpoint stalls a signing ladder outright.
VITE_RPC_1=
VITE_RPC_8453=
VITE_RPC_42161=
VITE_RPC_56=
VITE_RPC_43114=
