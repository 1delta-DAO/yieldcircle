# Everything here is optional — each value defaults to production.

# WalletConnect project id (cloud.reown.com). Without it the app ships
# injected-only and nobody on a phone browser can connect a wallet (the build
# warns). Register the site's origin on the project, or wallets show "cannot
# verify domain" over every signature request.
VITE_WC_PROJECT_ID=

# Overrides, for a proxy or a local stack only:
# VITE_BACKEND_BASE_URL=https://allocator.api.1delta.io
# VITE_SITE_URL=https://yieldcircle.io
# VITE_INDEX_BASE_URL=https://positions.1delta.io
# VITE_SOL_INDEX_BASE_URL=https://sol-positions.1delta.io
# VITE_SOCIAL_BASE_URL=https://social.1delta.io
# VITE_XLINK_URL=

# Per-chain RPC, optional: the transaction-receipt watcher (`sdk/txTrace.ts`).
# Asked first while it answers; without it (and behind it) reads rotate over
# public browser-friendly endpoints (`wallet/evmRpc.ts`).
VITE_RPC_1=
VITE_RPC_8453=
VITE_RPC_42161=
VITE_RPC_56=
VITE_RPC_43114=

# Solana RPC, optional: the signature-status watcher after a Solana
# transaction. Asked first when set; without it (and behind it) reads rotate
# over public browser-friendly endpoints (`wallet/solRpc.ts`). Never
# api.mainnet-beta, which refuses browser requests (403 on any Origin).
# VITE_RPC_SOLANA=https://mainnet.helius-rpc.com/?api-key=…
