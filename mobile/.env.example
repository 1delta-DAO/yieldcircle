# Copy to mobile/.env. Expo only exposes EXPO_PUBLIC_* to the app (they ship in the bundle: no secrets).
# Reown project id — the same one as the web's VITE_WC_PROJECT_ID; without it no wallet connects.
EXPO_PUBLIC_WC_PROJECT_ID=
# Optional overrides; unset = production (core's defaults).
EXPO_PUBLIC_BACKEND_BASE_URL=
EXPO_PUBLIC_INDEX_BASE_URL=
EXPO_PUBLIC_SOL_INDEX_BASE_URL=
EXPO_PUBLIC_SOCIAL_BASE_URL=
