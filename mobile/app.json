{
  "expo": {
    "name": "YieldCircle",
    "slug": "yieldcircle",
    "platforms": [
      "ios",
      "android"
    ],
    "scheme": "yieldcircle",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#000000",
    "ios": {
      "bundleIdentifier": "io.yieldcircle.app",
      "supportsTablet": false,
      "infoPlist": {
        "LSApplicationQueriesSchemes": [
          "metamask",
          "rainbow",
          "trust",
          "cbwallet",
          "zerion",
          "uniswap",
          "phantom",
          "safe",
          "metamask",
          "rainbow",
          "trust",
          "cbwallet",
          "zerion",
          "uniswap",
          "phantom",
          "safe"
        ],
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "io.yieldcircle.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#000000"
      }
    },
    "plugins": [
      "expo-router",
      "./plugins/wallet-queries.js"
    ],
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "17e62e78-22d2-4f64-a06e-6da4a5e31fbd"
      }
    },
    "owner": "alphachim"
  }
}
