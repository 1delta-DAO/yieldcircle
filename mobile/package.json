{
  "name": "@yieldcircle/mobile",
  "version": "0.1.0",
  "private": true,
  "main": "expo-router/entry",
  "description": "The phone app (Expo): wallets through Reown AppKit + wagmi, data and rules from @yieldcircle/core.",
  "scripts": {
    "start": "node ../scripts/mobile.mjs start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "typecheck": "tsc --noEmit",
    "bundle": "node ../scripts/mobile.mjs bundle",
    "doctor": "expo-doctor"
  },
  "dependencies": {
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/netinfo": "12.0.1",
    "@reown/appkit-react-native": "2.0.6",
    "@reown/appkit-wagmi-react-native": "2.0.6",
    "@tanstack/react-query": "5.91.3",
    "@walletconnect/react-native-compat": "*",
    "@walletconnect/safe-json": "*",
    "@yieldcircle/app": "workspace:*",
    "@yieldcircle/core": "workspace:*",
    "expo": "~58.0.19",
    "expo-application": "~58.1.2",
    "expo-constants": "~58.0.13",
    "expo-dev-client": "~58.0.14",
    "expo-linking": "~58.0.14",
    "expo-router": "~58.0.25",
    "expo-sqlite": "~58.0.13",
    "expo-status-bar": "~58.0.4",
    "react": "19.3.0",
    "react-native": "0.88.0",
    "react-native-get-random-values": "*",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-screens": "~4.30.0",
    "react-native-svg": "15.16.0",
    "react-native-url-polyfill": "*",
    "viem": "^2.47.6",
    "wagmi": "^2.19.0"
  },
  "devDependencies": {
    "@types/react": "^19.2.14",
    "typescript": "5.9.3",
    "zod": "3.25.76"
  },
  "expo": {
    "install": {
      "exclude": [
        "typescript"
      ]
    }
  }
}
