{
  "name": "yieldcircle",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:landing": "vite --config landing/vite.config.ts",
    "build": "tsc --noEmit && vite build",
    "build:landing": "tsc --noEmit && vite build --config landing/vite.config.ts && node landing/build-worker.mjs",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest --run",
    "shots": "node scripts/shots.mjs",
    "shots:baseline": "node scripts/shots.mjs --baseline",
    "deck:pdf": "node scripts/deck-pdf.mjs",
    "deploy": "node scripts/menu-seed.mjs && pnpm build && wrangler pages deploy dist --project-name yieldcircle --branch main",
    "deploy:preview": "node scripts/menu-seed.mjs && pnpm build && wrangler pages deploy dist --project-name yieldcircle --branch preview",
    "deploy:landing": "pnpm build:landing && wrangler pages deploy dist-landing --project-name yieldcircle-landing --branch main",
    "whitelist": "node scripts/whitelist.mjs",
    "logos": "node scripts/logos.mjs",
    "notes": "node scripts/notes.mjs",
    "lagoon": "node scripts/lagoon.mjs",
    "rpcs": "node scripts/rpcs.mjs",
    "menu-seed": "node scripts/menu-seed.mjs",
    "prewarm-check": "node scripts/prewarm-check.mjs",
    "search-rank": "node scripts/search-rank.mjs",
    "asset-class": "node scripts/asset-class.mjs",
    "paper-check": "node scripts/paper-check.mjs",
    "brand": "node scripts/brand-characters.mjs && python3 brand/gen.py && node scripts/brand.mjs"
  },
  "dependencies": {
    "@noble/curves": "1.9.1",
    "@noble/hashes": "1.8.0",
    "@tanstack/react-query": "5.91.3",
    "@yieldcircle/design": "workspace:*",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "uqr": "^0.1.3",
    "viem": "^2.47.6",
    "wagmi": "^2.19.0"
  },
  "devDependencies": {
    "@types/node": "^25.5.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "playwright": "^1.59.1",
    "typescript": "5.9.3",
    "vite": "^8.0.1",
    "vitest": "3.2.4"
  },
  "engines": {
    "node": ">=22"
  },
  "pnpm": {
    "overrides": {
      "@walletconnect/logger": "3.0.2"
    }
  }
}
