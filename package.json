{
  "name": "yieldcircle",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "pnpm --filter @yieldcircle/web run dev",
    "dev:landing": "pnpm --filter @yieldcircle/landing run dev",
    "build": "pnpm --filter @yieldcircle/web run build",
    "build:landing": "pnpm --filter @yieldcircle/landing run build",
    "preview": "pnpm --filter @yieldcircle/web run preview",
    "typecheck": "pnpm -r run typecheck",
    "test": "pnpm -r run test",
    "shots": "node scripts/shots.mjs",
    "shots:baseline": "node scripts/shots.mjs --baseline",
    "deck:pdf": "node scripts/deck-pdf.mjs",
    "deploy": "node scripts/menu-seed.mjs && pnpm --filter @yieldcircle/web run deploy",
    "deploy:preview": "node scripts/menu-seed.mjs && pnpm --filter @yieldcircle/web run deploy:preview",
    "deploy:landing": "pnpm --filter @yieldcircle/landing run deploy",
    "whitelist": "node scripts/whitelist.mjs",
    "logos": "node scripts/logos.mjs",
    "notes": "node scripts/notes.mjs",
    "lagoon": "node scripts/lagoon.mjs",
    "rpcs": "node scripts/rpcs.mjs",
    "menu-seed": "node scripts/menu-seed.mjs",
    "prewarm-check": "node scripts/prewarm-check.mjs",
    "search-rank": "node scripts/search-rank.mjs",
    "asset-class": "node scripts/asset-class.mjs",
    "paper-check": "node scripts/paper-check.mjs",
    "brand": "node scripts/brand-characters.mjs && python3 brand/gen.py && node scripts/brand.mjs"
  },
  "devDependencies": {
    "@types/node": "^25.5.0",
    "playwright": "^1.59.1",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "typescript": "5.9.3",
    "vite": "^8.0.1"
  },
  "engines": {
    "node": ">=22"
  },
  "pnpm": {
    "overrides": {
      "@walletconnect/logger": "3.0.2"
    }
  }
}
