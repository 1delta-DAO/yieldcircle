{
  "compilerOptions": {
    "target": "ES2022",
    // DOM for the types React Native also has (fetch, URL, AbortSignal) and for `localStorage`,
    // which the phone gets from expo-sqlite's polyfill. Every other browser global is kept out by
    // src/platform.test.ts.
    "lib": ["ES2022", "DOM"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noUnusedLocals": false,
    "skipLibCheck": true,
    "isolatedModules": true,
    "resolveJsonModule": true,
    "types": []
  },
  "include": ["src"],
  "exclude": ["src/**/*.test.ts"]
}
