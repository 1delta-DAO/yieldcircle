{
  "compilerOptions": {
    "target": "ES2022",
    // DOM only for the types React Native also provides: fetch, URL, AbortSignal, Headers.
    // Browser-only globals (window, document, localStorage, …) are kept out by src/platform.test.ts.
    "lib": ["ES2022", "DOM"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "noUnusedLocals": false,
    "skipLibCheck": true,
    "isolatedModules": true,
    "resolveJsonModule": true,
    "types": []
  },
  "include": ["src"],
  "exclude": ["src/**/*.test.ts"]
}
