{
  "name": "@yieldcircle/web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "The app (app.yieldcircle.io): index.html + src/, the beta gate in functions/.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest --run",
    "deploy": "pnpm run build && wrangler pages deploy dist --project-name yieldcircle --branch main",
    "deploy:preview": "pnpm run build && wrangler pages deploy dist --project-name yieldcircle --branch preview"
  },
  "dependencies": {
    "@noble/curves": "1.9.1",
    "@noble/hashes": "1.8.0",
    "@tanstack/react-query": "5.91.3",
    "@yieldcircle/design": "workspace:*",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "uqr": "^0.1.3",
    "viem": "^2.47.6",
    "wagmi": "^2.19.0"
  },
  "devDependencies": {
    "@types/node": "^25.5.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "typescript": "5.9.3",
    "vite": "^8.0.1",
    "vitest": "3.2.4"
  }
}
